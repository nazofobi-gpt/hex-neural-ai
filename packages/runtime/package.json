{
  "name": "@hex-neural/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @hex-neural/protocol",
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build -w @hex-neural/protocol && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@hex-neural/protocol": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
